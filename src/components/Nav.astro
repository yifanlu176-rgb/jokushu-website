---
const navItems = [
  { href: '/about', label: '源流' },
  { href: '/services', label: '奉事' },
  { href: '/articles', label: '文錄' },
  { href: '/collections', label: '藏品' },
  { href: '/contact', label: '通信' },
];

const pathname = Astro.url.pathname;
---

<nav class="site-nav" aria-label="主要导航">
  <div class="site-nav-inner">
    <div class="site-nav-head">
      <a class="site-brand" href="/" aria-label="蓐収">
        <span class="site-brand-copy">
          <strong>蓐収</strong>
          <small>JOKUSHU CO., LTD.</small>
        </span>
      </a>

      <div class="site-language-switch" role="group" aria-label="言語切替">
        <button class="site-language-button" type="button" data-lang-switch="zh" aria-pressed="false">
          中
        </button>
        <span class="site-language-divider" aria-hidden="true">｜</span>
        <button class="site-language-button" type="button" data-lang-switch="ja" aria-pressed="true">
          日
        </button>
      </div>
    </div>

    <div class="site-nav-rule" aria-hidden="true"></div>

    <ul class="site-nav-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
