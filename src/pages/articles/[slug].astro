---
import Layout from '../../layouts/Layout.astro';
import ArticleContentBlocks from '../../components/ArticleContentBlocks.astro';
import { getAllArticles, getArticleBySlug } from '../../lib/articles';

export async function getStaticPaths() {
  return getAllArticles().map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const article = slug ? getArticleBySlug(slug) : undefined;

if (!article) {
  return Astro.redirect('/articles');
}

const articles = getAllArticles();
const currentIndex = articles.findIndex((item) => item.slug === article.slug);
const newerArticle = currentIndex > 0 ? articles[currentIndex - 1] : undefined;
const olderArticle = currentIndex < articles.length - 1 ? articles[currentIndex + 1] : undefined;

const pageTitle = `${article.ja.title} | 蓐収株式会社`;
const pageDescription = article.ja.excerpt ?? article.zh.excerpt ?? '蓐収株式会社の文錄。';
const publishedTime = new Date(article.date).toISOString();
const ogImage = `/og/${article.slug}.png`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.ja.title,
  author: {
    '@type': 'Person',
    name: article.ja.author,
  },
  datePublished: article.date,
  publisher: {
    '@type': 'Organization',
    name: '蓐収株式会社',
    url: 'https://www.jokushu.co.jp',
  },
  description: pageDescription,
  mainEntityOfPage: `https://www.jokushu.co.jp/articles/${article.slug}`,
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  publishedTime={publishedTime}
  author={article.ja.author}
  image={ogImage}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <section class="article-page">
    <div class="article-shell">
      <a href="/articles" class="article-back" data-ui-copy="zh">← 返回文錄</a>
      <a href="/articles" class="article-back" data-ui-copy="ja">← 文録へ戻る</a>

      <article class="article-language" lang="zh-Hant" data-ui-copy="zh">
        <p class="article-eyebrow">{article.zh.category}｜{article.zh.dateDisplay}</p>
        <h1 class="article-title">{article.zh.title}</h1>
        {article.zh.subtitle ? <p class="article-subtitle">{article.zh.subtitle}</p> : null}
        <div class="article-body">
          <ArticleContentBlocks blocks={article.zh.content} />
        </div>
        <p class="article-signature">— {article.zh.author}</p>
      </article>

      <article class="article-language" lang="ja-JP" data-ui-copy="ja">
        <p class="article-eyebrow">{article.ja.category}｜{article.ja.dateDisplay}</p>
        <h1 class="article-title">{article.ja.title}</h1>
        {article.ja.subtitle ? <p class="article-subtitle">{article.ja.subtitle}</p> : null}
        <div class="article-body">
          <ArticleContentBlocks blocks={article.ja.content} />
        </div>
        <p class="article-signature">— {article.ja.author}</p>
      </article>

      {(newerArticle || olderArticle) && (
        <nav class="article-pagination" aria-label="Article pagination">
          <div class="article-pagination-language" data-ui-copy="zh">
            {newerArticle ? (
              <a class="article-pagination-link" href={`/articles/${newerArticle.slug}`}>
                ← 上一篇：{newerArticle.zh.title}
              </a>
            ) : <span class="article-pagination-placeholder"></span>}

            {olderArticle ? (
              <a class="article-pagination-link article-pagination-link-next" href={`/articles/${olderArticle.slug}`}>
                下一篇：{olderArticle.zh.title} →
              </a>
            ) : <span class="article-pagination-placeholder"></span>}
          </div>

          <div class="article-pagination-language" data-ui-copy="ja">
            {newerArticle ? (
              <a class="article-pagination-link" href={`/articles/${newerArticle.slug}`}>
                ← 前の記事：{newerArticle.ja.title}
              </a>
            ) : <span class="article-pagination-placeholder"></span>}

            {olderArticle ? (
              <a class="article-pagination-link article-pagination-link-next" href={`/articles/${olderArticle.slug}`}>
                次の記事：{olderArticle.ja.title} →
              </a>
            ) : <span class="article-pagination-placeholder"></span>}
          </div>
        </nav>
      )}
    </div>
  </section>
</Layout>

<style>
  .article-page {
    padding: 3rem 0 var(--space-screen-wide);
  }

  .article-shell {
    width: min(calc(100% - (var(--gutter) * 2)), 640px);
    margin: 0 auto;
  }

  .article-back,
  .article-eyebrow,
  .article-title,
  .article-subtitle,
  .article-signature {
    margin: 0;
  }

  .article-back {
    display: inline-flex;
    margin-bottom: 2rem;
    border-bottom: 0;
    color: var(--ink-light);
    font-size: var(--size-small);
    letter-spacing: var(--tracking-wide);
  }

  .article-back:hover {
    color: var(--accent-red);
  }

  .article-language {
    color: var(--ink-mid);
  }

  .article-eyebrow {
    color: var(--ink-light);
    font-size: var(--size-small);
    letter-spacing: var(--tracking-wide);
  }

  .article-title {
    margin-top: 0.9rem;
    color: var(--ink-main);
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: var(--weight-medium);
    line-height: 1.55;
    letter-spacing: 0.08em;
  }

  .article-subtitle {
    margin-top: 1rem;
    color: var(--ink-light);
    font-size: var(--size-body);
    line-height: 1.95;
    letter-spacing: 0.06em;
  }

  .article-body {
    margin-top: 3rem;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(p),
  .article-body :global(blockquote),
  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(h2) {
    margin-top: 3.5rem;
    color: var(--ink-main);
    font-size: var(--size-h3);
    font-weight: var(--weight-medium);
    line-height: 1.8;
    letter-spacing: 0.08em;
  }

  .article-body :global(h3) {
    margin-top: 2.25rem;
    color: var(--ink-main);
    font-size: var(--size-body);
    font-weight: var(--weight-medium);
    line-height: 1.95;
    letter-spacing: 0.08em;
  }

  .article-body :global(p) {
    color: var(--ink-mid);
    font-size: var(--size-body);
    line-height: 2.05;
    letter-spacing: 0.06em;
  }

  .article-body :global(p + p) {
    margin-top: 1.5rem;
  }

  .article-body :global(h2 + p),
  .article-body :global(h3 + p),
  .article-body :global(blockquote + p),
  .article-body :global(hr + p) {
    margin-top: 1.5rem;
  }

  .article-body :global(blockquote) {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-line);
    background: var(--paper-deep);
  }

  .article-body :global(blockquote p) {
    color: var(--ink-light);
  }

  .article-body :global(blockquote p + p) {
    margin-top: 1rem;
  }

  .article-body :global(hr) {
    width: 48px;
    height: 1px;
    margin: 2.75rem auto 0;
    border: 0;
    background: rgba(31, 26, 21, 0.16);
  }

  .article-body :global(.article-coda) {
    color: var(--ink-main);
  }

  .article-body :global(strong) {
    color: var(--ink-main);
    font-weight: var(--weight-medium);
  }

  .article-signature {
    margin-top: 3rem;
    color: var(--ink-light);
    font-size: var(--size-small);
    text-align: right;
    letter-spacing: 0.12em;
  }

  .article-pagination {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(31, 26, 21, 0.12);
  }

  .article-pagination-language {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .article-pagination-link,
  .article-pagination-placeholder {
    flex: 1 1 0;
    min-width: 0;
  }

  .article-pagination-link {
    border-bottom: 0;
    color: var(--ink-mid);
    font-size: var(--size-small);
    line-height: 1.9;
    letter-spacing: 0.05em;
  }

  .article-pagination-link:hover {
    color: var(--accent-red);
  }

  .article-pagination-link-next {
    text-align: right;
  }

  @media (max-width: 767px) {
    .article-page {
      padding-top: 2rem;
      padding-bottom: var(--space-screen);
    }

    .article-pagination-language {
      flex-direction: column;
    }

    .article-pagination-link-next {
      text-align: left;
    }
  }
</style>
