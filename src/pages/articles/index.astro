---
import Layout from '../../layouts/Layout.astro';
import page from '../../data/pages/articles.json';
import { getAllArticles } from '../../lib/articles';

const displayArticles = getAllArticles()
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((article) => ({
    href: `/articles/${article.slug}`,
    titleZh: article.zh.title,
    titleJa: article.ja.title,
    dateZh: article.zh.dateDisplay,
    dateJa: article.ja.dateDisplay,
    categoryZh: article.zh.category,
    categoryJa: article.ja.category,
    authorZh: article.zh.author,
    authorJa: article.ja.author,
  }));
---

<Layout title={page.title} description={page.description}>
  <section class="articles-page">
    <div class="articles-shell">
      <header class="articles-header reveal">
        <p class="articles-page-title" data-ui-copy="zh">{page.pageTitleZh}</p>
        <p class="articles-page-title" data-ui-copy="ja">{page.pageTitleJa}</p>
      </header>

      <section class="articles-intro reveal reveal-delay-1">
        <div class="articles-language-block" data-ui-copy="zh">
          {page.intro.zh.map((paragraph) => <p class="articles-intro-line">{paragraph}</p>)}
        </div>

        <div class="articles-language-block" data-ui-copy="ja">
          {page.intro.ja.map((paragraph) => <p class="articles-intro-line">{paragraph}</p>)}
        </div>
      </section>

      <div class="articles-rule" aria-hidden="true"></div>

      <section class="articles-taxonomy reveal">
        <div class="articles-language-block" data-ui-copy="zh">
          <p class="articles-taxonomy-title">{page.taxonomy.zh.title}</p>
          {page.taxonomy.zh.items.map((item) => <p class="articles-taxonomy-item">{item}</p>)}
        </div>

        <div class="articles-language-block" data-ui-copy="ja">
          <p class="articles-taxonomy-title">{page.taxonomy.ja.title}</p>
          {page.taxonomy.ja.items.map((item) => <p class="articles-taxonomy-item">{item}</p>)}
        </div>
      </section>

      <div class="articles-rule" aria-hidden="true"></div>

      <section class="articles-list reveal">
        {displayArticles.map((article) => (
          <article class="articles-item">
            <div class="articles-language-block" data-ui-copy="zh">
              <p class="articles-meta">{article.dateZh}｜{article.categoryZh}</p>
              <h1 class="articles-item-title">
                <a href={article.href}>{article.titleZh}</a>
              </h1>
              <p class="articles-author">— {article.authorZh}</p>
            </div>

            <div class="articles-language-block" data-ui-copy="ja">
              <p class="articles-meta">{article.dateJa}｜{article.categoryJa}</p>
              <h1 class="articles-item-title">
                <a href={article.href}>{article.titleJa}</a>
              </h1>
              <p class="articles-author">— {article.authorJa}</p>
            </div>
          </article>
        ))}
      </section>
    </div>
  </section>
</Layout>

<style>
  .articles-page {
    padding: 3rem 0 var(--space-screen-wide);
  }

  .articles-shell {
    width: min(calc(100% - (var(--gutter) * 2)), 640px);
    margin: 0 auto;
  }

  .articles-header,
  .articles-intro,
  .articles-taxonomy {
    text-align: center;
  }

  .articles-page-title,
  .articles-intro-line,
  .articles-taxonomy-title,
  .articles-taxonomy-item,
  .articles-meta,
  .articles-item-title,
  .articles-author {
    margin: 0;
  }

  .articles-page-title {
    color: var(--ink-main);
    font-size: var(--size-h2);
    line-height: var(--leading-tight);
    letter-spacing: 0.18em;
  }

  .articles-intro {
    margin-top: 3rem;
  }

  .articles-intro-line,
  .articles-taxonomy-title,
  .articles-taxonomy-item,
  .articles-meta,
  .articles-author {
    color: var(--ink-mid);
    font-size: var(--size-body);
    line-height: 2;
    letter-spacing: 0.06em;
  }

  .articles-intro-line + .articles-intro-line,
  .articles-taxonomy-item + .articles-taxonomy-item {
    margin-top: 0.2rem;
  }

  .articles-rule {
    width: 100%;
    height: 1px;
    margin: 3rem 0;
    background: rgba(31, 26, 21, 0.12);
  }

  .articles-taxonomy-title {
    margin-bottom: 1rem;
  }

  .articles-list {
    display: grid;
    gap: 2.5rem;
  }

  .articles-item {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(31, 26, 21, 0.08);
  }

  .articles-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .articles-meta {
    color: var(--ink-light);
    font-size: var(--size-small);
    letter-spacing: var(--tracking-wide);
  }

  .articles-item-title {
    margin-top: 0.55rem;
    color: var(--ink-main);
    font-size: var(--size-h3);
    font-weight: var(--weight-medium);
    line-height: 1.75;
    letter-spacing: 0.04em;
  }

  .articles-item-title a {
    border-bottom: 0;
    color: inherit;
  }

  .articles-author {
    margin-top: 0.65rem;
    color: var(--ink-light);
    font-size: var(--size-small);
  }

  @media (max-width: 767px) {
    .articles-page {
      padding-top: 2rem;
      padding-bottom: var(--space-screen);
    }

    .articles-rule {
      margin: 2.5rem 0;
    }
  }
</style>
