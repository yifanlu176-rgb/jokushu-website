---
import Layout from '../layouts/Layout.astro';
import home from '../data/pages/home.json';
---

<Layout
  title="蓐収株式會社 | 風水・命理・道教科儀・事業戦略"
  description="蓐収株式會社の第一版サイト。大阪を拠点に、在日華人の経営者へ風水鑑定、命理相談、祈願相談、文化商品、事業戦略の入口を示します。"
>
  <section class="hero-section">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="hero-kicker">{home.hero.kicker}</p>
        <h1 class="hero-title">
          {home.hero.titleLine1}<br>
          <em>{home.hero.titleLine2}</em>
        </h1>
        <p class="hero-lead">{home.hero.lead}</p>
        <p class="hero-summary">{home.hero.summary}</p>
        <div class="hero-actions button-row">
          <a class="button button-primary" href="/#contact">{home.hero.primaryCta}</a>
          <a class="button" href="/#services">{home.hero.secondaryCta}</a>
        </div>
      </div>

      <aside class="hero-panel reveal reveal-delay-1">
        <p class="hero-panel-title">{home.hero.panelTitle}</p>
        <ul class="hero-panel-list">
          {home.hero.panel.map((item) => (
            <li>
              <strong>{item.label}</strong>
              <span>{item.value}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="info-strip">
    <div class="info-strip-inner reveal">
      <strong>{home.infoStrip.primary}</strong>
      <span>・</span>
      <span>{home.infoStrip.secondary}</span>
      <span>・</span>
      <span>{home.infoStrip.tertiary}</span>
    </div>
  </section>

  <section id="about">
    <div class="section-inner">
      <div class="reveal">
        <p class="section-kicker">{home.about.kicker}</p>
        <h2 class="section-title">{home.about.titlePrefix}<em>{home.about.titleEmphasis}</em></h2>
        <div class="section-rule"></div>
        <p class="section-lead">{home.about.lead}</p>
      </div>

      <div class="section-grid-3" style="margin-top: 2rem;">
        {home.about.principles.map((item, index) => (
          <article class="card panel reveal" aria-label={item.title} style={`transition-delay:${index * 100}ms;`}>
            <p class="panel-title">{item.title}</p>
            <p class="panel-text">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services">
    <div class="section-inner">
      <div class="reveal">
        <p class="section-kicker">{home.services.kicker}</p>
        <h2 class="section-title">{home.services.titlePrefix}<em>{home.services.titleEmphasis}</em></h2>
        <div class="section-rule"></div>
        <p class="section-lead">{home.services.lead}</p>
      </div>

      <div class="section-grid-3" style="margin-top: 2rem;">
        {home.services.items.map((service, index) => (
          <article class="card service-card reveal" style={`transition-delay:${index * 80}ms;`}>
            <div class="service-card-head">
              <span class="service-card-index">{service.index}</span>
              <span class="service-card-tag">{service.tag}</span>
            </div>
            <h3 class="service-card-title">{service.title}</h3>
            <p class="service-card-body">{service.body}</p>
            <span class="service-card-link">詳細ページは次段で公開 →</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="process">
    <div class="section-inner">
      <div class="reveal">
        <p class="section-kicker">{home.process.kicker}</p>
        <h2 class="section-title">{home.process.titlePrefix}<em>{home.process.titleEmphasis}</em></h2>
        <div class="section-rule"></div>
      </div>

      <div class="flow-grid" style="margin-top: 2rem;">
        {home.process.items.map((item, index) => (
          <article class="card flow-step reveal" style={`transition-delay:${index * 90}ms;`}>
            <div class="flow-step-index">{item.step}</div>
            <h3 class="flow-step-title">{item.title}</h3>
            <p class="flow-step-text">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="section-inner">
      <div class="reveal">
        <p class="section-kicker">{home.pricing.kicker}</p>
        <h2 class="section-title">{home.pricing.titlePrefix}<em>{home.pricing.titleEmphasis}</em></h2>
        <div class="section-rule"></div>
        <p class="section-lead">{home.pricing.lead}</p>
      </div>

      <div class="pricing-grid" style="margin-top: 2rem;">
        {home.pricing.items.map((item, index) => (
          <article class="card pricing-card reveal" style={`transition-delay:${index * 90}ms;`}>
            <div class="pricing-label">{item.label}</div>
            <div class="pricing-price">{item.price}</div>
            <p class="pricing-note">詳細は料金ページで整理します。</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="section-inner">
      <div class="card cta-panel reveal">
        <div>
          <p class="section-kicker" style="margin-bottom: 0.7rem;">{home.contact.kicker}</p>
          <h2 class="section-title" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">{home.contact.titlePrefix}<em>{home.contact.titleEmphasis}</em></h2>
          <p>{home.contact.lead}</p>
        </div>
        <div class="button-row">
          <a class="button button-primary" href="/#about">{home.contact.primaryCta}</a>
          <a class="button" href="/#services">{home.contact.secondaryCta}</a>
        </div>
      </div>
      <p class="legal-note" style="margin-top: 1rem;">
        {home.contact.note}
      </p>
    </div>
  </section>
</Layout>
