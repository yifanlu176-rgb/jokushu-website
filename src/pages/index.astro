---
import Layout from '../layouts/Layout.astro';
import home from '../data/pages/home.json';
import { getAllArticles } from '../lib/articles';

const featuredArticles = getAllArticles()
  .slice(0, 4)
  .map((article) => ({
    href: `/articles/${article.slug}`,
    dateZh: article.zh.dateDisplay,
    dateJa: article.ja.dateDisplay,
    titleZh: article.zh.title,
    titleJa: article.ja.title,
  }));
---

<Layout title={home.title} description={home.description}>
  <section class="home-screen home-opening">
    <div class="home-screen-inner home-opening-inner reveal">
      <div class="home-opening-copy">
        <h1 class="home-mark">{home.opening.mark}</h1>

        <div class="home-copy-block" data-ui-copy="zh">
          {home.opening.zh.map((line) => <p class="home-annotation">{line}</p>)}
        </div>

        <div class="home-copy-block" data-ui-copy="ja">
          {home.opening.ja.map((line) => <p class="home-annotation">{line}</p>)}
        </div>
      </div>

      <a class="home-scroll-link" href={home.opening.scrollTarget}>
        <span aria-hidden="true">↓</span>
        <span>{home.opening.scrollLabel}</span>
      </a>
    </div>
  </section>

  <section id="home-tagline" class="home-screen home-tagline-section">
    <div class="home-screen-inner reveal">
      <p class="home-tagline" data-ui-copy="zh">{home.tagline.zh}</p>
      <p class="home-tagline" data-ui-copy="ja">{home.tagline.ja}</p>
    </div>
  </section>

  <section id="home-source" class="home-screen home-source-section">
    <div class="home-narrow reveal">
      <div class="home-copy-block" data-ui-copy="zh">
        {home.sourceIntro.zh.map((line) => <p class="home-prose">{line}</p>)}
        <a class="home-block-link" href={home.sourceIntro.href}>{home.sourceIntro.linkZh}</a>
      </div>

      <div class="home-copy-block" data-ui-copy="ja">
        {home.sourceIntro.ja.map((line) => <p class="home-prose">{line}</p>)}
        <a class="home-block-link" href={home.sourceIntro.href}>{home.sourceIntro.linkJa}</a>
      </div>
    </div>
  </section>

  <section class="home-screen home-services-section">
    <div class="home-wide reveal">
      <h2 class="home-section-title" data-ui-copy="zh">{home.services.titleZh}</h2>
      <h2 class="home-section-title" data-ui-copy="ja">{home.services.titleJa}</h2>

      <div class="home-service-grid">
        {home.services.items.map((item) => (
          <article class="home-service-item">
            <p class="home-service-title" data-ui-copy="zh">{item.titleZh}</p>
            <p class="home-service-title" data-ui-copy="ja">{item.titleJa}</p>
            <p class="home-service-keywords" data-ui-copy="zh">{item.keywordsZh}</p>
            <p class="home-service-keywords" data-ui-copy="ja">{item.keywordsJa}</p>
          </article>
        ))}
      </div>

      <div class="home-link-row">
        <a class="home-block-link" data-ui-copy="zh" href={home.services.href}>{home.services.linkZh}</a>
        <a class="home-block-link" data-ui-copy="ja" href={home.services.href}>{home.services.linkJa}</a>
      </div>
    </div>
  </section>

  <section class="home-screen home-writings-section">
    <div class="home-wide reveal">
      <h2 class="home-section-title" data-ui-copy="zh">{home.writings.titleZh}</h2>
      <h2 class="home-section-title" data-ui-copy="ja">{home.writings.titleJa}</h2>

      <div class="home-article-list">
        {featuredArticles.map((article) => (
          <article class="home-article-item">
            <p class="home-article-date" data-ui-copy="zh">{article.dateZh}</p>
            <p class="home-article-date" data-ui-copy="ja">{article.dateJa}</p>
            <a class="home-article-link" href={article.href} data-ui-copy="zh">{article.titleZh}</a>
            <a class="home-article-link" href={article.href} data-ui-copy="ja">{article.titleJa}</a>
          </article>
        ))}
      </div>

      <div class="home-link-row">
        <a class="home-block-link" data-ui-copy="zh" href={home.writings.href}>{home.writings.linkZh}</a>
        <a class="home-block-link" data-ui-copy="ja" href={home.writings.href}>{home.writings.linkJa}</a>
      </div>
    </div>
  </section>

  <section class="home-screen home-contact-section">
    <div class="home-screen-inner reveal">
      <div class="home-copy-block" data-ui-copy="zh">
        {home.contact.zh.map((line) => <p class="home-closing-line">{line}</p>)}
        <div class="home-contact-button-row">
          <a class="button" href={home.contact.href}>{home.contact.buttonZh}</a>
        </div>
      </div>

      <div class="home-copy-block" data-ui-copy="ja">
        {home.contact.ja.map((line) => <p class="home-closing-line">{line}</p>)}
        <div class="home-contact-button-row">
          <a class="button" href={home.contact.href}>{home.contact.buttonJa}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
