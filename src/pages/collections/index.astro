---
import Layout from '../../layouts/Layout.astro';
import page from '../../data/pages/collections.json';
import { getItemsByVolume } from '../../lib/collections';

const volumes = [1, 2, 3] as const;
const volumeData = volumes.map((v) => ({
  number: v,
  titleZh: page.volumeTitles[String(v) as keyof typeof page.volumeTitles].zh,
  titleJa: page.volumeTitles[String(v) as keyof typeof page.volumeTitles].ja,
  items: getItemsByVolume(v),
}));
---

<Layout title={page.title} description={page.description}>
  <section class="collections-page">
    <div class="collections-shell">
      <header class="collections-header reveal">
        <p class="collections-page-title" data-ui-copy="zh">{page.pageTitleZh}</p>
        <p class="collections-page-title" data-ui-copy="ja">{page.pageTitleJa}</p>
      </header>

      <section class="collections-intro reveal reveal-delay-1">
        <div class="collections-language-block" data-ui-copy="zh">
          {page.intro.zh.map((paragraph) => <p class="collections-intro-line">{paragraph}</p>)}
        </div>

        <div class="collections-language-block" data-ui-copy="ja">
          {page.intro.ja.map((paragraph) => <p class="collections-intro-line">{paragraph}</p>)}
        </div>
      </section>

      <div class="collections-rule" aria-hidden="true"></div>

      {volumeData.map((vol) => (
        <section class="collections-volume reveal">
          <h2 class="collections-volume-title" data-ui-copy="zh">{vol.titleZh}</h2>
          <h2 class="collections-volume-title" data-ui-copy="ja">{vol.titleJa}</h2>

          {vol.items.length > 0 ? (
            <div class="collections-items">
              {vol.items.map((item) => (
                <a href={`/collections/${item.slug}`} class="collections-item-card">
                  <div class="collections-item-image">
                    {item.zh.images.length > 0 ? (
                      <img src={`/collections/${item.zh.images[0]}`} alt={item.ja.name} loading="lazy" />
                    ) : (
                      <img src="/collections/placeholder.svg" alt="" aria-hidden="true" />
                    )}
                  </div>
                  <div class="collections-item-info" data-ui-copy="zh">
                    <p class="collections-item-name">{item.zh.name}</p>
                    {item.zh.subtitle && <p class="collections-item-subtitle">{item.zh.subtitle}</p>}
                    <p class="collections-item-price">{item.zh.priceRange}</p>
                  </div>
                  <div class="collections-item-info" data-ui-copy="ja">
                    <p class="collections-item-name">{item.ja.name}</p>
                    {item.ja.subtitle && <p class="collections-item-subtitle">{item.ja.subtitle}</p>}
                    <p class="collections-item-price">{item.ja.priceRange}</p>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="collections-volume-empty">
              <p data-ui-copy="zh">{page.emptyVolume.zh}</p>
              <p data-ui-copy="ja">{page.emptyVolume.ja}</p>
            </div>
          )}

          <div class="collections-rule" aria-hidden="true"></div>
        </section>
      ))}

      <section class="collections-closing reveal">
        <p class="collections-closing-text" data-ui-copy="zh">{page.closing.zh}</p>
        <p class="collections-closing-text" data-ui-copy="ja">{page.closing.ja}</p>

        <div class="collections-contact-link">
          <a href={page.contact.href} data-ui-copy="zh">［ {page.contact.labelZh} ］</a>
          <a href={page.contact.href} data-ui-copy="ja">［ {page.contact.labelJa} ］</a>
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
  .collections-page {
    padding: 3rem 0 var(--space-screen-wide);
  }

  .collections-shell {
    width: min(calc(100% - (var(--gutter) * 2)), 640px);
    margin: 0 auto;
  }

  .collections-header,
  .collections-intro,
  .collections-closing {
    text-align: center;
  }

  .collections-page-title,
  .collections-intro-line,
  .collections-closing-text {
    margin: 0;
  }

  .collections-page-title {
    color: var(--ink-main);
    font-size: var(--size-h2);
    line-height: var(--leading-tight);
    letter-spacing: 0.18em;
  }

  .collections-intro {
    margin-top: 3rem;
  }

  .collections-intro-line,
  .collections-closing-text {
    color: var(--ink-mid);
    font-size: var(--size-body);
    line-height: 2;
    letter-spacing: 0.06em;
  }

  .collections-intro-line + .collections-intro-line {
    margin-top: 0.3rem;
  }

  .collections-rule {
    width: 100%;
    height: 1px;
    margin: 3rem 0;
    background: rgba(31, 26, 21, 0.12);
  }

  .collections-volume-title {
    margin: 0 0 2rem;
    color: var(--ink-main);
    font-size: var(--size-h3);
    font-weight: var(--weight-medium);
    text-align: center;
    letter-spacing: 0.12em;
  }

  .collections-items {
    display: grid;
    gap: 2.5rem;
  }

  .collections-item-card {
    display: block;
    border-bottom: 0;
    transition: opacity 300ms ease;
  }

  .collections-item-card:hover {
    opacity: 0.75;
  }

  .collections-item-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-deep);
    border: 1px solid rgba(31, 26, 21, 0.08);
  }

  .collections-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collections-item-info {
    margin-top: 1rem;
  }

  .collections-item-name {
    margin: 0;
    color: var(--ink-main);
    font-size: var(--size-body);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
  }

  .collections-item-subtitle {
    margin: 0.3rem 0 0;
    color: var(--ink-light);
    font-size: var(--size-small);
    letter-spacing: 0.04em;
  }

  .collections-item-price {
    margin: 0.6rem 0 0;
    color: var(--ink-mid);
    font-size: var(--size-small);
    letter-spacing: 0.04em;
  }

  .collections-volume-empty {
    text-align: center;
  }

  .collections-volume-empty p {
    margin: 0;
    color: var(--ink-light);
    font-size: var(--size-body);
    letter-spacing: 0.06em;
  }

  .collections-contact-link {
    margin-top: 1.5rem;
  }

  .collections-contact-link a {
    border-bottom: 0;
    color: var(--ink-main);
    font-size: var(--size-body);
    letter-spacing: 0.12em;
  }

  .collections-contact-link a:hover {
    color: var(--accent-red);
  }

  @media (max-width: 767px) {
    .collections-page {
      padding-top: 2rem;
      padding-bottom: var(--space-screen);
    }

    .collections-rule {
      margin: 2.5rem 0;
    }
  }
</style>
