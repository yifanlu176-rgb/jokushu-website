---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/sections.css';
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ja' | 'zh' | 'en';
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
}

const {
  title = 'JOKUSHU',
  description = 'JOKUSHU の公式サイトです。',
  lang = 'ja',
  image = '/logo.svg',
  type = 'website',
  publishedTime,
  author = 'JOKUSHU'
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const htmlLang = lang === 'zh' ? 'zh-TW' : lang === 'en' ? 'en' : 'ja-JP';
const locale = lang === 'zh' ? 'zh_TW' : lang === 'en' ? 'en_US' : 'ja_JP';
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="title" content={title}>
  <meta name="description" content={description}>
  <meta name="author" content={author}>
  <meta name="theme-color" content="#F5EFE3">
  <link rel="canonical" href={canonicalURL}>

  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={socialImage}>
  <meta property="og:site_name" content="JOKUSHU">
  <meta property="og:locale" content={locale}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {author && <meta property="article:author" content={author}>}

  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={socialImage}>

  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">
  <meta name="language" content="Japanese">
  <meta name="geo.region" content="JP-27">
  <meta name="geo.placename" content="Osaka">
  <meta name="geo.position" content="34.6937;135.5023">
  <meta name="ICBM" content="34.6937, 135.5023">
  <meta name="keywords" content="JOKUSHU,風水,命理,祈願,企画,大阪,日本">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/logo.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500&family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@400;500&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">

  <SpeedInsights />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "JOKUSHU",
      "alternateName": "JOKUSHU CO., LTD.",
      "description": "風水・命理・祈願・企画を扱う相談型サービス",
      "url": "https://www.jokushu.co.jp",
      "logo": "https://www.jokushu.co.jp/logo.svg",
      "image": "https://www.jokushu.co.jp/logo.svg",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Osaka",
        "addressRegion": "Osaka",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "34.6937",
        "longitude": "135.5023"
      },
      "areaServed": ["JP", "CN", "TW", "HK"],
      "serviceType": ["風水鑑定", "命理相談", "祈願", "企画支援", "開運用品"],
      "priceRange": "$$",
      "email": "contact@jokushu.co.jp"
    }
  </script>
</head>
<body data-site-lang={lang}>
  <Nav />
  <main id="content">
    <slot />
  </main>
  <Footer />

  <script>
    const supportedLanguages = ['ja', 'zh'];
    const languageButtons = document.querySelectorAll('[data-lang-switch]');
    const root = document.documentElement;
    const body = document.body;
    const storedLanguage = window.localStorage.getItem('jokushu-language');
    const browserLanguage = navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'ja';
    const initialLanguage = supportedLanguages.includes(storedLanguage ?? '')
      ? storedLanguage
      : supportedLanguages.includes(body.dataset.siteLang ?? '')
        ? body.dataset.siteLang
        : browserLanguage;

    const applyLanguage = (nextLanguage) => {
      const currentLanguage = supportedLanguages.includes(nextLanguage) ? nextLanguage : 'ja';
      body.dataset.uiLanguage = currentLanguage;
      root.dataset.uiLanguage = currentLanguage;

      languageButtons.forEach((button) => {
        const isActive = button.dataset.langSwitch === currentLanguage;
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      window.localStorage.setItem('jokushu-language', currentLanguage);

      const localizedControls = document.querySelectorAll('form [data-ui-copy]');

      localizedControls.forEach((control) => {
        const element = control;
        const isActive = element.dataset.uiCopy === currentLanguage;
        const formControl = (
          element instanceof HTMLInputElement ||
          element instanceof HTMLTextAreaElement ||
          element instanceof HTMLSelectElement ||
          element instanceof HTMLButtonElement
        )
          ? element
          : null;

        if (formControl) {
          formControl.disabled = !isActive;
        }
      });

      const languageFields = document.querySelectorAll('form input[name="_language"]');

      languageFields.forEach((field) => {
        field.value = currentLanguage;
      });
    };

    applyLanguage(initialLanguage);

    languageButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyLanguage(button.dataset.langSwitch);
      });
    });

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.12 });

    reveals.forEach(item => observer.observe(item));

    const formspreeForms = document.querySelectorAll('form[data-formspree]');

    formspreeForms.forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('[type="submit"]');
        const status = form.querySelector('[data-formspree-status]');
        const thanks = form.dataset.formspreeThanks || '/contact/thanks';
        const formEnabled = form.dataset.formspreeEnabled !== 'false';

        if (!formEnabled || !form.action) {
          if (status) status.textContent = 'Formspree endpoint 未配置，当前无法发送。';
          return;
        }

        if (submitButton) submitButton.disabled = true;
        if (status) status.textContent = '送信中...';

        try {
          const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: new FormData(form),
            headers: {
              Accept: 'application/json',
            },
          });

          if (response.ok) {
            window.location.assign(thanks);
            return;
          }

          if (status) status.textContent = '送信に失敗しました。内容を確認して、もう一度お試しください。';
        } catch (error) {
          if (status) status.textContent = '通信エラーが発生しました。時間をおいて再試行してください。';
        }

        if (submitButton) submitButton.disabled = false;
      });
    });
  </script>
</body>
</html>
